<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AtomiCloud.DotnetBase.UnitTest</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.msbuild" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="GitHubActionsTestLogger" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- The published sibling TestHelpers are consumed rather than reimplemented: the
         classification suite asserts envelopes with Problems.TestHelper and Results with
         Result.TestHelper, which is also this node's registry dogfood of both packages. -->
    <PackageReference Include="AtomiCloud.Diene.Problems.TestHelper" />
    <PackageReference Include="AtomiCloud.Diene.Result.TestHelper" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Lib/Lib.csproj" />
    <ProjectReference Include="../TestHelper/TestHelper.csproj" />
  </ItemGroup>

</Project>
