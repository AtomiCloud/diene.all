meta {
  name: Acquire management token
  type: http
  seq: 2
}

post {
  url: {{logtoEndpoint}}/oidc/token
  body: formUrlEncoded
  auth: basic
}

auth:basic {
  username: {{process.env.SIT_LOGTO_MANAGEMENT_CLIENT_ID}}
  password: {{process.env.SIT_LOGTO_MANAGEMENT_CLIENT_SECRET}}
}

body:form-urlencoded {
  grant_type: client_credentials
  resource: {{logtoManagementResource}}
  scope: all
}

script:post-response {
  if (res.getStatus() === 200 && res.body && res.body.access_token) {
    bru.setVar("managementToken", res.body.access_token);
  }
}

tests {
  test("the Management API credential is accepted", function () {
    expect(res.getStatus(), "management token status").to.equal(200);
    expect(res.body.access_token, "access_token").to.be.a("string").and.not.equal("");
    console.log("[sit] management token acquired for " + bru.getEnvVar("logtoManagementResource"));
  });
}

docs {
  Revocation goes through Logto's Management API, which is a different resource
  from this service's own audience and therefore a different token.
}
