meta {
  name: Acquire machine token
  type: http
  seq: 1
}

post {
  url: {{logtoEndpoint}}/oidc/token
  body: formUrlEncoded
  auth: basic
}

auth:basic {
  username: {{process.env.SIT_LOGTO_CLIENT_ID}}
  password: {{process.env.SIT_LOGTO_CLIENT_SECRET}}
}

body:form-urlencoded {
  grant_type: client_credentials
  resource: {{audience}}
  scope: all
}

script:post-response {
  if (res.getStatus() === 200 && res.body && res.body.access_token) {
    bru.setVar("accessToken", res.body.access_token);
  }
}

tests {
  test("landscape-local Logto issues a machine token for this service's audience", function () {
    expect(res.getStatus(), "token endpoint status").to.equal(200);
    expect(res.body.token_type, "token_type").to.be.a("string");
    expect(res.body.access_token, "access_token").to.be.a("string").and.not.equal("");
    console.log("[sit] access token acquired, expires_in=" + res.body.expires_in);
  });
}

docs {
  The audience is the service's own `castform` coordinate, supplied as
  `SIT_AUDIENCE`. A token minted by a DIFFERENT landscape's Logto, or for a
  different audience, is rejected by the service — that negative case belongs to
  the auth dogfood proof, not to this happy-path acquisition.
}
