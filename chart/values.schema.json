{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Diene Xenon Values",
    "description": "Generated schema for the diene xenon conditional metrics-server chart.",
    "type": "object",
    "properties": {
        "global": {
            "description": "Values shared with the vendored metrics-server dependency through Helm's supported parent-to-subchart global-values contract.",
            "type": "object",
            "required": [
                "labelPrefix"
            ],
            "properties": {
                "instance": {
                    "description": "Optional physical-instance metadata. The instance remains outside LPSM.",
                    "type": "object",
                    "properties": {
                        "physicalId": {
                            "description": "Repository-qualified physical instance id.",
                            "type": "string",
                            "pattern": "^[a-z0-9._:/-]+$",
                            "minLength": 1
                        }
                    }
                },
                "labelPrefix": {
                    "description": "Single prefix used by every service-tree label and annotation helper.",
                    "type": "string",
                    "pattern": "^[a-z0-9.-]+$",
                    "minLength": 1
                },
                "serviceTree": {
                    "description": "Stable service-tree projection. Platform is always the release namespace; landscape and cluster are added by independent overlays.",
                    "type": "object",
                    "required": [
                        "service",
                        "module",
                        "layer"
                    ],
                    "properties": {
                        "layer": {
                            "description": "Architecture layer.",
                            "type": "string",
                            "pattern": "^[0-9]+$"
                        },
                        "module": {
                            "description": "Module name.",
                            "type": "string",
                            "pattern": "^[a-z0-9]+$"
                        },
                        "service": {
                            "description": "Service name.",
                            "type": "string",
                            "pattern": "^[a-z0-9]+$"
                        }
                    }
                }
            }
        },
        "metricsServer": {
            "description": "Per-landscape enablement toggle and the vendored metrics-server chart inputs. The whole chart is gated by `metricsServer.enabled`: it defaults ON here for every cloud and on-prem landscape (EKS classic/Auto, DOKS, and on-prem do not preinstall metrics-server) and is flipped OFF only by the k3d/lapras overlay, because k3s bundles metrics-server. Final per-profile ENV roster entries stay outside this node.",
            "type": "object",
            "required": [
                "enabled"
            ],
            "properties": {
                "args": {
                    "description": "Kubelet scrape arguments. Secure TLS is the cloud/on-prem default; the k3d/insecure posture is an overlay decision documented in the README matrix.",
                    "type": "array"
                },
                "enabled": {
                    "description": "Per-landscape toggle. ON for cloud/on-prem, OFF for k3d/lapras.",
                    "type": "boolean"
                },
                "fullnameOverride": {
                    "description": "Conforming metrics-server fullname (`\u003cservice\u003e-\u003cdashless-token\u003e`).",
                    "type": "string",
                    "pattern": "^[a-z0-9]+-[a-z0-9]+$"
                },
                "podAnnotations": {
                    "description": "Reloader opt-in on the metrics-server pod. The vendored integration patch independently projects the global service-tree metadata onto the Deployment and pod; this map retains only the upstream-supported opt-out surface.",
                    "type": "object",
                    "properties": {
                        "reloader.stakater.com/auto": {
                            "type": "string"
                        }
                    }
                },
                "podSecurityContext": {
                    "description": "Pod-level security context satisfying the baseline-plus VAP policy.",
                    "type": "object",
                    "properties": {
                        "fsGroup": {
                            "type": "integer"
                        },
                        "runAsGroup": {
                            "type": "integer"
                        },
                        "runAsNonRoot": {
                            "type": "boolean"
                        },
                        "runAsUser": {
                            "type": "integer"
                        }
                    }
                },
                "replicas": {
                    "description": "Highly available replica count for managed-cloud deployments.",
                    "type": "integer",
                    "minimum": 1
                },
                "resources": {
                    "description": "CPU and memory envelopes for the metrics-server container.",
                    "type": "object",
                    "properties": {
                        "limits": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        },
                        "requests": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
