{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Sulfur Values",
    "description": "Generated schema for the sulfur cert-manager wrapper chart.",
    "type": "object",
    "properties": {
        "config": {
            "description": "sulfur contract surface mirrored for static conformance. Values must match the upstream block.",
            "type": "object",
            "required": [
                "enableGatewayAPI"
            ],
            "properties": {
                "enableGatewayAPI": {
                    "description": "Gateway API support is required (kgateway integration); the canonical knob is upstream.config.enableGatewayAPI.",
                    "type": "boolean"
                }
            }
        },
        "instance": {
            "description": "Optional physical-instance metadata. The instance remains outside LPSM.",
            "type": "object",
            "properties": {
                "physicalId": {
                    "type": "string"
                }
            }
        },
        "labelPrefix": {
            "description": "Single source of truth for the service-tree label prefix. The supported render path (scripts/local/gen-identity-values.sh) derives the subchart upstream.global.commonLabels keys from this one value; there is no static mirror.",
            "type": "string",
            "pattern": "^[a-z0-9.-]+$",
            "minLength": 1
        },
        "serviceTree": {
            "description": "Stable four-slot service-tree projection. Landscape and cluster are added by independent overlays.",
            "type": "object",
            "required": [
                "platform",
                "service",
                "module",
                "layer"
            ],
            "properties": {
                "layer": {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                },
                "module": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                },
                "platform": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                },
                "service": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                }
            }
        },
        "upstream": {
            "description": "Pure-passthrough cert-manager engine. Issuers live in zinc, never here.",
            "type": "object",
            "required": [
                "crds"
            ],
            "properties": {
                "cainjector": {
                    "type": "object",
                    "properties": {
                        "containerSecurityContext": {
                            "type": "object",
                            "properties": {
                                "runAsNonRoot": {
                                    "type": "boolean"
                                }
                            }
                        },
                        "podAnnotations": {
                            "type": "object",
                            "properties": {
                                "reloader.stakater.com/auto": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                }
                            }
                        },
                        "resources": {
                            "type": "object",
                            "properties": {
                                "limits": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "requests": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "config": {
                    "description": "ControllerConfiguration. enableGatewayAPI is the canonical Gateway API knob (not the legacy feature gate).",
                    "type": "object",
                    "properties": {
                        "enableGatewayAPI": {
                            "type": "boolean"
                        }
                    }
                },
                "containerSecurityContext": {
                    "description": "Container hardening. cert-manager defaults already supply drop ALL, readOnlyRootFilesystem, and allowPrivilegeEscalation:false; runAsNonRoot is added at container level so every workload satisfies the workload-baseline VAP.",
                    "type": "object",
                    "properties": {
                        "runAsNonRoot": {
                            "type": "boolean"
                        }
                    }
                },
                "crds": {
                    "description": "cert-manager CRDs are installed by the engine chart; keep them on uninstall so certificates survive.",
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "keep": {
                            "type": "boolean"
                        }
                    }
                },
                "enabled": {
                    "type": "boolean"
                },
                "imageNamespace": {
                    "type": "string"
                },
                "imageRegistry": {
                    "description": "Sequential-minor upgrade path from v1.15 is enforced by this repo's own CI (Q-G22).",
                    "type": "string"
                },
                "podAnnotations": {
                    "description": "Reloader opt-in on the controller pod (family default).",
                    "type": "object",
                    "properties": {
                        "reloader.stakater.com/auto": {
                            "description": "Nullable so a landscape/cluster overlay can opt a workload out by setting it to null.",
                            "type": [
                                "string",
                                "null"
                            ]
                        }
                    }
                },
                "resources": {
                    "description": "Controller requests/limits. Required so rendered workloads satisfy the inherited workload-baseline VAP (requests+limits for cpu+memory).",
                    "type": "object",
                    "properties": {
                        "limits": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        },
                        "requests": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "startupapicheck": {
                    "description": "One-shot startup API check Job. No Reloader annotation (not a long-running workload).",
                    "type": "object",
                    "properties": {
                        "containerSecurityContext": {
                            "type": "object",
                            "properties": {
                                "runAsNonRoot": {
                                    "type": "boolean"
                                }
                            }
                        },
                        "resources": {
                            "type": "object",
                            "properties": {
                                "limits": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "requests": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "webhook": {
                    "type": "object",
                    "properties": {
                        "containerSecurityContext": {
                            "type": "object",
                            "properties": {
                                "runAsNonRoot": {
                                    "type": "boolean"
                                }
                            }
                        },
                        "podAnnotations": {
                            "type": "object",
                            "properties": {
                                "reloader.stakater.com/auto": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                }
                            }
                        },
                        "resources": {
                            "type": "object",
                            "properties": {
                                "limits": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "requests": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
