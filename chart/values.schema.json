{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Diene Xenon Values",
    "description": "Generated schema for the diene xenon conditional metrics-server chart.",
    "type": "object",
    "properties": {
        "instance": {
            "description": "Optional physical-instance metadata. The instance remains outside LPSM.",
            "type": "object",
            "properties": {
                "physicalId": {
                    "type": "string"
                }
            }
        },
        "labelPrefix": {
            "description": "Prefix used by every service-tree label and annotation helper.",
            "type": "string",
            "pattern": "^[a-z0-9.-]+$",
            "minLength": 1
        },
        "metricsServer": {
            "description": "Per-landscape enablement toggle and the vendored metrics-server chart inputs. The whole chart is gated by `metricsServer.enabled`: it defaults ON here for every cloud and on-prem landscape (EKS classic/Auto, DOKS, and on-prem do not preinstall metrics-server) and is flipped OFF only by the k3d/lapras overlay, because k3s bundles metrics-server. Final per-profile ENV roster entries stay outside this node.",
            "type": "object",
            "required": [
                "enabled"
            ],
            "properties": {
                "args": {
                    "description": "Kubelet scrape arguments. Secure TLS is the cloud/on-prem default; the k3d/insecure posture is an overlay decision documented in the README matrix.",
                    "type": "array"
                },
                "enabled": {
                    "description": "Per-landscape toggle. ON for cloud/on-prem, OFF for k3d/lapras.",
                    "type": "boolean"
                },
                "fullnameOverride": {
                    "description": "Conforming metrics-server fullname (`\u003cservice\u003e-\u003cdashless-token\u003e`).",
                    "type": "string",
                    "pattern": "^[a-z0-9]+-[a-z0-9]+$"
                },
                "podAnnotations": {
                    "description": "Reloader opt-in plus service-tree annotations on the metrics-server pod. Reloader is opt-in at the controller and baked ON here by the wrapper. Because the annotation reaches the pod through the metrics-server subchart's `podAnnotations` map (Helm coalesces subchart values and cannot drop a single key), a stateful/unsafe landscape opts out by overriding the value to 'false' — Reloader only reloads on the literal 'true', so any other value opts out.",
                    "type": "object",
                    "properties": {
                        "atomi.cloud/module": {
                            "type": "string"
                        },
                        "atomi.cloud/platform": {
                            "type": "string"
                        },
                        "atomi.cloud/service": {
                            "type": "string"
                        },
                        "reloader.stakater.com/auto": {
                            "type": "string"
                        }
                    }
                },
                "podLabels": {
                    "description": "Service-tree identity stamped onto the metrics-server pod.",
                    "type": "object",
                    "properties": {
                        "atomi.cloud/layer": {
                            "type": "string"
                        },
                        "atomi.cloud/module": {
                            "type": "string"
                        },
                        "atomi.cloud/platform": {
                            "type": "string"
                        },
                        "atomi.cloud/service": {
                            "type": "string"
                        }
                    }
                },
                "podSecurityContext": {
                    "description": "Pod-level security context satisfying the baseline-plus VAP policy.",
                    "type": "object",
                    "properties": {
                        "fsGroup": {
                            "type": "integer"
                        },
                        "runAsGroup": {
                            "type": "integer"
                        },
                        "runAsNonRoot": {
                            "type": "boolean"
                        },
                        "runAsUser": {
                            "type": "integer"
                        }
                    }
                },
                "replicas": {
                    "description": "Highly available replica count for managed-cloud deployments.",
                    "type": "integer",
                    "minimum": 1
                },
                "resources": {
                    "description": "CPU and memory envelopes for the metrics-server container.",
                    "type": "object",
                    "properties": {
                        "limits": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        },
                        "requests": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "serviceTree": {
            "description": "Stable four-slot service-tree projection. Landscape and cluster are added by independent overlays.",
            "type": "object",
            "required": [
                "platform",
                "service",
                "module",
                "layer"
            ],
            "properties": {
                "layer": {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                },
                "module": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                },
                "platform": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                },
                "service": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                }
            }
        }
    }
}
