{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Platinum Values",
    "description": "Generated schema for the platinum Gateway API chart.",
    "type": "object",
    "required": [
        "fullnameOverride"
    ],
    "properties": {
        "devHost": {
            "description": "ENTEI dev-host shared-Gateway mode. When enabled, platinum renders the shared GatewayClass, Gateway, and LoadBalancer only; per-host Certificate, ListenerSet, and HTTPRoute are owned by the exposure materializer, not this chart.",
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                }
            }
        },
        "fullnameOverride": {
            "description": "Primary workload fullname (`\u003cservice\u003e-\u003ctoken\u003e`). The wrapper convention names the chart's primary served endpoint.",
            "type": "string",
            "pattern": "^[a-z0-9]+-[a-z0-9]+$"
        },
        "gateway": {
            "description": "Gateway API edge: shared GatewayClass, shared Gateway, the LoadBalancer exposure, and the health route.",
            "type": "object",
            "properties": {
                "aws": {
                    "type": "object",
                    "properties": {
                        "eipAllocationIds": {
                            "type": "array",
                            "uniqueItems": true,
                            "items": {
                                "type": "string"
                            }
                        },
                        "subnetIds": {
                            "type": "array",
                            "uniqueItems": true,
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "classname": {
                    "description": "GatewayClass name platinum owns. Registered-fleet and local LAPRAS-class gateways reference it.",
                    "type": "string",
                    "pattern": "^[a-z0-9-]+$"
                },
                "controllerName": {
                    "description": "kgateway controller binding for the GatewayClass.",
                    "type": "string",
                    "pattern": "^[a-z0-9.-]+/[a-z0-9-]+$"
                },
                "enabled": {
                    "type": "boolean"
                },
                "health": {
                    "type": "object",
                    "properties": {
                        "expectedStatus": {
                            "type": "string"
                        },
                        "path": {
                            "description": "Fixed health path the traffic controller polls once per cluster per tick.",
                            "type": "string",
                            "pattern": "^/.*"
                        }
                    }
                },
                "oci": {
                    "type": "object",
                    "properties": {
                        "reservedPublicIp": {
                            "type": "string"
                        }
                    }
                },
                "port": {
                    "type": "integer",
                    "maximum": 65535,
                    "minimum": 1
                },
                "provider": {
                    "type": "string",
                    "enum": [
                        "aws",
                        "oci",
                        "digitalocean"
                    ]
                },
                "proxy": {
                    "type": "object",
                    "properties": {
                        "selector": {
                            "description": "Labels selecting the kgateway gateway-proxy pods the LoadBalancer forwards to. Wired per cluster at install.",
                            "type": "object"
                        }
                    }
                }
            }
        },
        "healthBackend": {
            "description": "Platinum-owned /healthz responder. It is the gateway health-route backend and the chart's primary workload.",
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "image": {
                    "type": "object",
                    "properties": {
                        "pullPolicy": {
                            "type": "string",
                            "enum": [
                                "Always",
                                "IfNotPresent",
                                "Never"
                            ]
                        },
                        "repository": {
                            "type": "string"
                        },
                        "tag": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                        }
                    }
                },
                "podSecurityContext": {
                    "type": "object",
                    "properties": {
                        "fsGroup": {
                            "type": "integer"
                        },
                        "runAsGroup": {
                            "type": "integer"
                        },
                        "runAsNonRoot": {
                            "type": "boolean"
                        },
                        "runAsUser": {
                            "type": "integer"
                        }
                    }
                },
                "port": {
                    "type": "integer",
                    "maximum": 65535,
                    "minimum": 1
                },
                "reloader": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "replicas": {
                    "type": "integer",
                    "minimum": 1
                },
                "resources": {
                    "type": "object",
                    "properties": {
                        "limits": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        },
                        "requests": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "securityContext": {
                    "type": "object",
                    "properties": {
                        "allowPrivilegeEscalation": {
                            "type": "boolean"
                        },
                        "capabilities": {
                            "type": "object",
                            "properties": {
                                "drop": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                }
                            }
                        },
                        "readOnlyRootFilesystem": {
                            "type": "boolean"
                        },
                        "runAsGroup": {
                            "type": "integer"
                        },
                        "runAsNonRoot": {
                            "type": "boolean"
                        },
                        "runAsUser": {
                            "type": "integer"
                        }
                    }
                }
            }
        },
        "instance": {
            "description": "Optional physical-instance metadata. The instance remains outside LPSM.",
            "type": "object",
            "properties": {
                "physicalId": {
                    "type": "string"
                }
            }
        },
        "kgatewayCrds": {
            "description": "Standard-channel and kgateway CRD subchart. Enabled in the k3d integration tier; off for unit-tier static checks.",
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                }
            }
        },
        "labelPrefix": {
            "description": "Prefix used by every service-tree label and annotation helper.",
            "type": "string",
            "pattern": "^[a-z0-9.-]+$",
            "minLength": 1
        },
        "registeredCertificates": {
            "description": "Registered-fleet wildcard Certificates. Zinc owns the DNS-01 ClusterIssuer definition (charts/zinc); this chart only issues against it.",
            "type": "object",
            "properties": {
                "backup": {
                    "type": "object",
                    "properties": {
                        "dnsNames": {
                            "type": "array",
                            "uniqueItems": true,
                            "items": {
                                "type": "string"
                            }
                        },
                        "domain": {
                            "description": "Second R53 base-domain wildcard for cluster-endpoint failover TLS (S8 backup domain).",
                            "type": "string",
                            "pattern": "^\\*\\.[a-z0-9.-]+$"
                        }
                    }
                },
                "enabled": {
                    "type": "boolean"
                },
                "issuerRef": {
                    "type": "object",
                    "properties": {
                        "kind": {
                            "type": "string",
                            "enum": [
                                "ClusterIssuer",
                                "Issuer"
                            ]
                        },
                        "name": {
                            "description": "ClusterIssuer name owned by charts/zinc and instantiated once per cluster.",
                            "type": "string"
                        }
                    }
                },
                "primary": {
                    "type": "object",
                    "properties": {
                        "dnsNames": {
                            "type": "array",
                            "uniqueItems": true,
                            "items": {
                                "type": "string"
                            }
                        },
                        "domain": {
                            "description": "Primary registered-fleet base-domain wildcard (atomi.cloud).",
                            "type": "string",
                            "pattern": "^\\*\\.[a-z0-9.-]+$"
                        }
                    }
                }
            }
        },
        "serviceTree": {
            "description": "Stable four-slot service-tree projection. Landscape and cluster are added by independent overlays.",
            "type": "object",
            "required": [
                "platform",
                "service",
                "module",
                "layer"
            ],
            "properties": {
                "layer": {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                },
                "module": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                },
                "platform": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                },
                "service": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                }
            }
        },
        "upstream": {
            "description": "Pinned kgateway control-plane subchart. Enabled in the k3d integration tier; off for unit-tier static checks.",
            "type": "object",
            "properties": {
                "controller": {
                    "type": "object",
                    "properties": {
                        "image": {
                            "type": "object",
                            "properties": {
                                "repository": {
                                    "type": "string"
                                },
                                "tag": {
                                    "type": "string"
                                }
                            }
                        },
                        "service": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "enabled": {
                    "type": "boolean"
                },
                "fullnameOverride": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+-[a-z0-9]+$"
                }
            }
        }
    }
}
