{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Diene Zinc Values",
    "description": "Generated schema for the diene zinc cert-manager issuer chart.",
    "type": "object",
    "properties": {
        "instance": {
            "description": "Optional physical-instance metadata. The instance remains outside LPSM.",
            "type": "object",
            "properties": {
                "physicalId": {
                    "description": "Repository-qualified physical instance id.",
                    "type": "string",
                    "pattern": "^[a-z0-9._:/-]+$",
                    "minLength": 1
                }
            }
        },
        "issuer": {
            "description": "The reusable Let's Encrypt ACME DNS-01 (Cloudflare) ClusterIssuer definition. Zinc owns NO Certificate: certificate owners reference a stable ClusterIssuer name. ONE definition is rendered once per `refs` entry (cluster-scoped, so it is instantiated per cluster); there are no per-landscape/zone issuer variants beyond the LE-directory selection carried by the overlays.",
            "type": "object",
            "properties": {
                "acme": {
                    "type": "object",
                    "properties": {
                        "directories": {
                            "description": "Named Let's Encrypt ACME directory endpoints. A `refs` entry selects one by name; the five-landscape LE-directory map (Q-I33) is expressed by the landscape overlays choosing production or staging.",
                            "type": "object",
                            "properties": {
                                "production": {
                                    "type": "string"
                                },
                                "staging": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "email": {
                    "description": "ACME registration contact address.",
                    "type": "string"
                },
                "refs": {
                    "description": "ClusterIssuer instances to materialize from the one definition. Registered clusters instantiate a single stable ref; the ENTEI host-role overlay instantiates the staging+production pair concurrently on the shared host.",
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "directory": {
                                "type": "string"
                            },
                            "name": {
                                "type": "string"
                            }
                        }
                    }
                },
                "solver": {
                    "type": "object",
                    "properties": {
                        "cloudflare": {
                            "type": "object",
                            "properties": {
                                "apiTokenSecretRef": {
                                    "type": "object",
                                    "properties": {
                                        "key": {
                                            "description": "Key inside that Secret (folder-prefixed by the ExternalSecret rewrite).",
                                            "type": "string"
                                        },
                                        "name": {
                                            "description": "The ExternalSecret-materialized Secret carrying the Cloudflare token.",
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        },
                        "dnsZones": {
                            "description": "DNS-01 solver zone restriction. Empty = unrestricted (registered fleet); the ENTEI overlay pins the hosted-development authority zones.",
                            "type": "array",
                            "uniqueItems": true,
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "labelPrefix": {
            "description": "Prefix used by every service-tree label and annotation helper.",
            "type": "string",
            "pattern": "^[a-z0-9.-]+$",
            "minLength": 1
        },
        "secret": {
            "description": "One service-scoped ExternalSecret that materializes the Cloudflare API token from the platform SecretStore created by carbon via the SoS chain. The DNS-01 solver references this Secret only; a token is never inlined.",
            "type": "object",
            "properties": {
                "enabled": {
                    "description": "Render the ExternalSecret.",
                    "type": "boolean"
                },
                "refreshInterval": {
                    "description": "ESO refresh cadence.",
                    "type": "string"
                },
                "serviceFolder": {
                    "description": "Service-folder path fanned in with a ZINC_ prefix (holds the CF token).",
                    "type": "string"
                },
                "sharedFolder": {
                    "description": "Shared-folder path fanned in with a SHARED_ prefix.",
                    "type": "string"
                },
                "store": {
                    "type": "object",
                    "properties": {
                        "kind": {
                            "description": "The platform SecretStore is namespace-scoped (created by carbon).",
                            "type": "string",
                            "enum": [
                                "SecretStore",
                                "ClusterSecretStore"
                            ]
                        },
                        "name": {
                            "description": "Platform SecretStore name.",
                            "type": "string"
                        }
                    }
                }
            }
        },
        "serviceTree": {
            "description": "Stable service-tree projection. Platform is always the release namespace (never a value); landscape is added by independent overlays.",
            "type": "object",
            "required": [
                "service",
                "module",
                "layer"
            ],
            "properties": {
                "layer": {
                    "description": "Architecture layer.",
                    "type": "string",
                    "pattern": "^[0-9]+$"
                },
                "module": {
                    "description": "Module name.",
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                },
                "service": {
                    "description": "Service name.",
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                }
            }
        }
    }
}
