{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Diene Sulfur Values",
    "description": "Generated schema for the diene sulfur cert-manager engine wrapper chart.",
    "type": "object",
    "properties": {
        "certmanager": {
            "description": "Pure passthrough of the vendored jetstack/cert-manager engine. The wrapper adds NO Issuer/ClusterIssuer of its own — the issuer set is zinc's separate chart; sulfur owns only the cert-manager engine. This map carries only the minimal upstream overrides: CRD installation, the stable Gateway API config field, resource envelopes, container hardening, and Reloader opt-in.",
            "type": "object",
            "properties": {
                "cainjector": {
                    "type": "object",
                    "properties": {
                        "containerSecurityContext": {
                            "type": "object",
                            "properties": {
                                "allowPrivilegeEscalation": {
                                    "type": "boolean"
                                },
                                "capabilities": {
                                    "type": "object",
                                    "properties": {
                                        "drop": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                },
                                "readOnlyRootFilesystem": {
                                    "type": "boolean"
                                },
                                "runAsNonRoot": {
                                    "type": "boolean"
                                }
                            }
                        },
                        "deploymentAnnotations": {
                            "type": "object",
                            "properties": {
                                "reloader.stakater.com/auto": {
                                    "type": "string"
                                }
                            }
                        },
                        "replicaCount": {
                            "type": "integer"
                        },
                        "resources": {
                            "type": "object",
                            "properties": {
                                "limits": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "requests": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "config": {
                    "description": "cert-manager controller runtime configuration (ControllerConfiguration). Gateway API support (Gateway/HTTPRoute TLS for kgateway) is enabled through the stable `enableGatewayAPI` config field. The dead `ExperimentalGatewayAPISupport` feature gate (a no-op since it defaulted true in v1.15) is deliberately NOT set anywhere; the hygiene gate rejects it.",
                    "type": "object",
                    "properties": {
                        "apiVersion": {
                            "type": "string"
                        },
                        "enableGatewayAPI": {
                            "type": "boolean"
                        },
                        "kind": {
                            "type": "string"
                        }
                    }
                },
                "containerSecurityContext": {
                    "description": "Baseline-plus container hardening for the controller (upstream omits the container-level runAsNonRoot the VAP profile requires).",
                    "type": "object",
                    "properties": {
                        "allowPrivilegeEscalation": {
                            "type": "boolean"
                        },
                        "capabilities": {
                            "type": "object",
                            "properties": {
                                "drop": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                }
                            }
                        },
                        "readOnlyRootFilesystem": {
                            "type": "boolean"
                        },
                        "runAsNonRoot": {
                            "type": "boolean"
                        }
                    }
                },
                "crds": {
                    "description": "CRD lifecycle stance. CRDs are installed as Helm-managed objects and kept on release uninstall (`keep: true`) so issued Certificates/Issuers survive a chart removal. cert-manager applies CRDs through Helm's ordinary object channel (no separate skipCrds/Server-Side-Apply CRD path is used).",
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "description": "Install the cert-manager CRDs with the release.",
                            "type": "boolean"
                        },
                        "keep": {
                            "description": "Retain CRDs on uninstall to protect existing custom resources.",
                            "type": "boolean"
                        }
                    }
                },
                "deploymentAnnotations": {
                    "description": "Reloader opt-in on the controller Deployment; restarts on config change.",
                    "type": "object",
                    "properties": {
                        "reloader.stakater.com/auto": {
                            "type": "string"
                        }
                    }
                },
                "fullnameOverride": {
                    "type": "string"
                },
                "nameOverride": {
                    "description": "Pin the canonical upstream `cert-manager*` object names (pure passthrough). Without these the aliased dependency folds the `certmanager` alias into every rendered name — including container names, which the API server rejects as non-RFC-1123. `nameOverride` fixes the chart-name-derived identifiers (container names, app labels); `fullnameOverride` fixes the object names.",
                    "type": "string"
                },
                "replicaCount": {
                    "description": "Single controller replica; cert-manager leader-elects, so one active instance is the generic default.",
                    "type": "integer"
                },
                "resources": {
                    "description": "CPU and memory envelopes for the controller container (VAP requires both requests and limits on every workload container).",
                    "type": "object",
                    "properties": {
                        "limits": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        },
                        "requests": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "startupapicheck": {
                    "type": "object",
                    "properties": {
                        "containerSecurityContext": {
                            "type": "object",
                            "properties": {
                                "allowPrivilegeEscalation": {
                                    "type": "boolean"
                                },
                                "capabilities": {
                                    "type": "object",
                                    "properties": {
                                        "drop": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                },
                                "readOnlyRootFilesystem": {
                                    "type": "boolean"
                                },
                                "runAsNonRoot": {
                                    "type": "boolean"
                                }
                            }
                        },
                        "resources": {
                            "type": "object",
                            "properties": {
                                "limits": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "requests": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "webhook": {
                    "type": "object",
                    "properties": {
                        "containerSecurityContext": {
                            "type": "object",
                            "properties": {
                                "allowPrivilegeEscalation": {
                                    "type": "boolean"
                                },
                                "capabilities": {
                                    "type": "object",
                                    "properties": {
                                        "drop": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                },
                                "readOnlyRootFilesystem": {
                                    "type": "boolean"
                                },
                                "runAsNonRoot": {
                                    "type": "boolean"
                                }
                            }
                        },
                        "deploymentAnnotations": {
                            "type": "object",
                            "properties": {
                                "reloader.stakater.com/auto": {
                                    "type": "string"
                                }
                            }
                        },
                        "replicaCount": {
                            "type": "integer"
                        },
                        "resources": {
                            "type": "object",
                            "properties": {
                                "limits": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "requests": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "global": {
            "description": "Values shared with the vendored cert-manager dependency through Helm's supported parent-to-subchart global-values contract.",
            "type": "object",
            "required": [
                "labelPrefix"
            ],
            "properties": {
                "commonLabels": {
                    "description": "Static service-tree labels projected onto every upstream cert-manager resource through cert-manager's supported `global.commonLabels` passthrough. The namespace-sourced platform label cannot be expressed as a static value, so the wrapper-owned LPSM ConfigMap carries the full dynamic LPSM projection. Overlays append the landscape label. Keys must stay consistent with `global.serviceTree`; the unit `labels` gate enforces the correspondence.",
                    "type": "object",
                    "properties": {
                        "atomi.cloud/layer": {
                            "type": "string"
                        },
                        "atomi.cloud/module": {
                            "type": "string"
                        },
                        "atomi.cloud/service": {
                            "type": "string"
                        }
                    }
                },
                "instance": {
                    "description": "Optional physical-instance metadata. The instance remains outside LPSM.",
                    "type": "object",
                    "properties": {
                        "physicalId": {
                            "description": "Repository-qualified physical instance id.",
                            "type": "string",
                            "pattern": "^[a-z0-9._:/-]+$",
                            "minLength": 1
                        }
                    }
                },
                "labelPrefix": {
                    "description": "Single prefix used by every wrapper service-tree label and annotation helper.",
                    "type": "string",
                    "pattern": "^[a-z0-9.-]+$",
                    "minLength": 1
                },
                "serviceTree": {
                    "description": "Stable service-tree projection. Platform is always the release namespace; landscape and cluster are added by independent overlays.",
                    "type": "object",
                    "required": [
                        "service",
                        "module",
                        "layer"
                    ],
                    "properties": {
                        "layer": {
                            "description": "Architecture layer.",
                            "type": "string",
                            "pattern": "^[0-9]+$"
                        },
                        "module": {
                            "description": "Module name.",
                            "type": "string",
                            "pattern": "^[a-z0-9]+$"
                        },
                        "service": {
                            "description": "Service name.",
                            "type": "string",
                            "pattern": "^[a-z0-9]+$"
                        }
                    }
                }
            }
        }
    }
}
