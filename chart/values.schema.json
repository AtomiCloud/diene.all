{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Zinc Values",
    "description": "Generated schema for the zinc cert-manager issuer-set chart.",
    "type": "object",
    "properties": {
        "entei": {
            "description": "ENTEI host-role materialization. The overlay enables both stable issuance-class refs.",
            "type": "object",
            "properties": {
                "dnsZones": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string"
                    }
                },
                "enabled": {
                    "type": "boolean"
                },
                "production": {
                    "type": "object",
                    "required": [
                        "name",
                        "accountSecretName",
                        "server"
                    ],
                    "properties": {
                        "accountSecretName": {
                            "type": "string",
                            "pattern": "^zinc-[a-z0-9]+$"
                        },
                        "name": {
                            "type": "string",
                            "pattern": "^zinc-[a-z0-9]+$"
                        },
                        "server": {
                            "type": "string",
                            "pattern": "^https://.+/directory$"
                        }
                    }
                },
                "staging": {
                    "type": "object",
                    "required": [
                        "name",
                        "accountSecretName",
                        "server"
                    ],
                    "properties": {
                        "accountSecretName": {
                            "type": "string",
                            "pattern": "^zinc-[a-z0-9]+$"
                        },
                        "name": {
                            "type": "string",
                            "pattern": "^zinc-[a-z0-9]+$"
                        },
                        "server": {
                            "type": "string",
                            "pattern": "^https://.+/directory$"
                        }
                    }
                }
            }
        },
        "issuer": {
            "description": "Registered-fleet issuer materialization. Landscape overlays select only the ACME directory.",
            "type": "object",
            "required": [
                "email",
                "name",
                "accountSecretName",
                "server"
            ],
            "properties": {
                "accountSecretName": {
                    "type": "string",
                    "pattern": "^zinc-[a-z0-9]+$"
                },
                "cloudflare": {
                    "type": "object",
                    "properties": {
                        "apiTokenSecretRef": {
                            "type": "object",
                            "required": [
                                "name",
                                "key"
                            ],
                            "properties": {
                                "key": {
                                    "type": "string",
                                    "pattern": "^SHARED_[A-Z0-9_]+$"
                                },
                                "name": {
                                    "type": "string",
                                    "pattern": "^zinc-[a-z0-9]+$"
                                }
                            }
                        }
                    }
                },
                "dnsZones": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string"
                    }
                },
                "email": {
                    "type": "string",
                    "pattern": "^[^@ ]+@[^@ ]+\\.[^@ ]+$"
                },
                "name": {
                    "type": "string",
                    "pattern": "^zinc-[a-z0-9]+$"
                },
                "server": {
                    "type": "string",
                    "pattern": "^https://.+/directory$"
                }
            }
        },
        "labelPrefix": {
            "description": "Single configurable prefix used by every service-tree label and annotation.",
            "type": "string",
            "pattern": "^[a-z0-9.-]+$",
            "minLength": 1
        },
        "secret": {
            "description": "Cloudflare DNS-01 token materialized through ESO and the platform SecretStore.",
            "type": "object",
            "required": [
                "folder"
            ],
            "properties": {
                "folder": {
                    "type": "string",
                    "pattern": "^/[a-z0-9/_-]+$"
                },
                "refreshInterval": {
                    "type": "string"
                },
                "store": {
                    "type": "object",
                    "required": [
                        "kind",
                        "name"
                    ],
                    "properties": {
                        "kind": {
                            "type": "string",
                            "enum": [
                                "ClusterSecretStore",
                                "SecretStore"
                            ]
                        },
                        "name": {
                            "type": "string",
                            "pattern": "^zinc-[a-z0-9]+$"
                        }
                    }
                }
            }
        },
        "serviceTree": {
            "description": "Stable four-slot service-tree projection. Landscape and cluster are overlay-owned.",
            "type": "object",
            "required": [
                "platform",
                "service",
                "module",
                "layer"
            ],
            "properties": {
                "layer": {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                },
                "module": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                },
                "platform": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                },
                "service": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                }
            }
        }
    }
}
