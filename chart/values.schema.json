{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Diene Chlorine Values",
    "description": "Generated schema for the diene Chlorine Reloader wrapper.",
    "type": "object",
    "properties": {
        "global": {
            "type": "object",
            "properties": {
                "instance": {
                    "description": "Optional physical-instance metadata. The instance remains outside LPSM.",
                    "type": "object",
                    "properties": {
                        "physicalId": {
                            "description": "Repository-qualified physical instance id.",
                            "type": "string",
                            "pattern": "^[a-z0-9._:/-]+$",
                            "minLength": 1
                        }
                    }
                },
                "labelPrefix": {
                    "description": "Prefix used by every service-tree label and annotation helper.",
                    "type": "string",
                    "pattern": "^[a-z0-9.-]+$",
                    "minLength": 1
                },
                "serviceTree": {
                    "description": "Stable four-slot service-tree projection. Landscape and cluster arrive from independent overlays.",
                    "type": "object",
                    "required": [
                        "platform",
                        "service",
                        "module",
                        "layer"
                    ],
                    "properties": {
                        "layer": {
                            "description": "Architecture layer.",
                            "type": "string",
                            "pattern": "^[0-9]+$"
                        },
                        "module": {
                            "description": "Module name.",
                            "type": "string",
                            "pattern": "^[a-z0-9]+$"
                        },
                        "platform": {
                            "description": "Platform identity. Always sourced from the release namespace.",
                            "type": "string",
                            "pattern": "^[a-z0-9-]+$"
                        },
                        "service": {
                            "description": "Service name.",
                            "type": "string",
                            "pattern": "^[a-z0-9]+$"
                        }
                    }
                }
            }
        },
        "reloader": {
            "description": "Vendored Stakater Reloader dependency. Chlorine is a near-pure passthrough: the subchart owns the workload; this block only pins the fleet conventions.",
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "fullnameOverride": {
                    "description": "Exactly-one-dash fullname on the vendored dependency (`\u003cservice\u003e-\u003ctoken\u003e`).",
                    "type": "string"
                },
                "reloader": {
                    "type": "object",
                    "properties": {
                        "autoReloadAll": {
                            "description": "PRESERVE annotation opt-in. Never auto-reload-all; workloads opt in via the stakater annotation.",
                            "type": "boolean"
                        },
                        "deployment": {
                            "type": "object",
                            "properties": {
                                "containerSecurityContext": {
                                    "description": "Baseline-plus container hardening (VAP conformance).",
                                    "type": "object",
                                    "properties": {
                                        "allowPrivilegeEscalation": {
                                            "type": "boolean"
                                        },
                                        "capabilities": {
                                            "type": "object",
                                            "properties": {
                                                "drop": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string"
                                                    }
                                                }
                                            }
                                        },
                                        "runAsNonRoot": {
                                            "type": "boolean"
                                        }
                                    }
                                },
                                "labels": {
                                    "description": "Service-tree labels rendered through the subchart's tpl pipeline.",
                                    "type": "object",
                                    "properties": {
                                        "{{ include \"diene-chlorine.labelPrefix\" . }}/cluster": {
                                            "type": "string"
                                        },
                                        "{{ include \"diene-chlorine.labelPrefix\" . }}/landscape": {
                                            "type": "string"
                                        },
                                        "{{ include \"diene-chlorine.labelPrefix\" . }}/layer": {
                                            "type": "string"
                                        },
                                        "{{ include \"diene-chlorine.labelPrefix\" . }}/module": {
                                            "type": "string"
                                        },
                                        "{{ include \"diene-chlorine.labelPrefix\" . }}/platform": {
                                            "type": "string"
                                        },
                                        "{{ include \"diene-chlorine.labelPrefix\" . }}/service": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "pod": {
                                    "type": "object",
                                    "properties": {
                                        "annotations": {
                                            "description": "Service-tree and reversible instance metadata annotations.",
                                            "type": "object",
                                            "properties": {
                                                "{{ include \"diene-chlorine.labelPrefix\" . }}/cluster": {
                                                    "type": "string"
                                                },
                                                "{{ include \"diene-chlorine.labelPrefix\" . }}/instance-label": {
                                                    "type": "string"
                                                },
                                                "{{ include \"diene-chlorine.labelPrefix\" . }}/instance-original": {
                                                    "type": "string"
                                                },
                                                "{{ include \"diene-chlorine.labelPrefix\" . }}/landscape": {
                                                    "type": "string"
                                                },
                                                "{{ include \"diene-chlorine.labelPrefix\" . }}/layer": {
                                                    "type": "string"
                                                },
                                                "{{ include \"diene-chlorine.labelPrefix\" . }}/module": {
                                                    "type": "string"
                                                },
                                                "{{ include \"diene-chlorine.labelPrefix\" . }}/platform": {
                                                    "type": "string"
                                                },
                                                "{{ include \"diene-chlorine.labelPrefix\" . }}/service": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                },
                                "resources": {
                                    "description": "Requests and limits (VAP conformance; Reloader is a light controller).",
                                    "type": "object",
                                    "properties": {
                                        "limits": {
                                            "type": "object",
                                            "properties": {
                                                "cpu": {
                                                    "type": "string"
                                                },
                                                "memory": {
                                                    "type": "string"
                                                }
                                            }
                                        },
                                        "requests": {
                                            "type": "object",
                                            "properties": {
                                                "cpu": {
                                                    "type": "string"
                                                },
                                                "memory": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "readOnlyRootFileSystem": {
                            "description": "Read-only root filesystem with a chart-managed writable /tmp volume (VAP baseline-plus).",
                            "type": "boolean"
                        },
                        "reloadStrategy": {
                            "description": "Only annotated workloads are reloaded (the fleet opt-in posture).",
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}
