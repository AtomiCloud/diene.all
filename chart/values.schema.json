{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Diene Chlorine Values",
    "description": "Generated schema for the diene chlorine stakater/reloader wrapper chart.",
    "type": "object",
    "properties": {
        "global": {
            "description": "Values shared with the vendored reloader dependency through Helm's supported parent-to-subchart global-values contract.",
            "type": "object",
            "required": [
                "labelPrefix"
            ],
            "properties": {
                "instance": {
                    "description": "Optional physical-instance metadata. The instance remains outside LPSM.",
                    "type": "object",
                    "properties": {
                        "physicalId": {
                            "description": "Repository-qualified physical instance id.",
                            "type": "string",
                            "pattern": "^[a-z0-9._:/-]+$",
                            "minLength": 1
                        }
                    }
                },
                "labelPrefix": {
                    "description": "Single prefix used by every wrapper service-tree label and annotation helper.",
                    "type": "string",
                    "pattern": "^[a-z0-9.-]+$",
                    "minLength": 1
                },
                "serviceTree": {
                    "description": "Stable service-tree projection. Platform is always the release namespace; landscape and cluster are added by independent overlays.",
                    "type": "object",
                    "required": [
                        "service",
                        "module",
                        "layer"
                    ],
                    "properties": {
                        "layer": {
                            "description": "Architecture layer.",
                            "type": "string",
                            "pattern": "^[0-9]+$"
                        },
                        "module": {
                            "description": "Module name.",
                            "type": "string",
                            "pattern": "^[a-z0-9]+$"
                        },
                        "service": {
                            "description": "Service name.",
                            "type": "string",
                            "pattern": "^[a-z0-9]+$"
                        }
                    }
                }
            }
        },
        "reloader": {
            "description": "Pure passthrough of the vendored stakater/reloader engine. Reloader is the last hop of the secret-rotation chain (Infisical rotate → ESO sync → Reloader restart): it restarts a workload only when a Secret/ConfigMap the workload references changes. This map carries only the minimal upstream overrides: canonical names, the pinned image tag, the annotation-opt-in reload stance, resource envelopes, container hardening, and the Reloader self opt-in.",
            "type": "object",
            "properties": {
                "fullnameOverride": {
                    "type": "string"
                },
                "image": {
                    "description": "Pin the controller image to the chart appVersion (VAP forbids `:latest`).",
                    "type": "object",
                    "properties": {
                        "tag": {
                            "type": "string"
                        }
                    }
                },
                "nameOverride": {
                    "description": "Pin the canonical `chlorine-reloader` object names (fullname convention: `\u003cservice\u003e-\u003ctoken\u003e`, exactly one dash). `nameOverride` fixes the chart-name derived identifiers (app labels, container name); `fullnameOverride` fixes the rendered object names.",
                    "type": "string"
                },
                "reloader": {
                    "description": "Upstream reloader controller configuration.",
                    "type": "object",
                    "properties": {
                        "autoReloadAll": {
                            "description": "Annotation OPT-IN, never auto-reload-all. Reloader restarts only the workloads that carry `reloader.stakater.com/auto: \"true\"` (the opt-in the helm-wrapper bakes into every family chart by default). Flipping this to true would reload EVERY workload unless it opts out — the fleet convention is the opposite, so it stays false.",
                            "type": "boolean"
                        },
                        "deployment": {
                            "type": "object",
                            "properties": {
                                "annotations": {
                                    "description": "Reloader opt-in on its own controller Deployment; restarts on config change like every other family chart.",
                                    "type": "object",
                                    "properties": {
                                        "reloader.stakater.com/auto": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "containerSecurityContext": {
                                    "description": "Baseline-plus container hardening (upstream leaves the container securityContext empty; the shared VAP profile requires non-root, no privilege escalation, a read-only root filesystem, and all caps dropped).",
                                    "type": "object",
                                    "properties": {
                                        "allowPrivilegeEscalation": {
                                            "type": "boolean"
                                        },
                                        "capabilities": {
                                            "type": "object",
                                            "properties": {
                                                "drop": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string"
                                                    }
                                                }
                                            }
                                        },
                                        "readOnlyRootFilesystem": {
                                            "type": "boolean"
                                        },
                                        "runAsNonRoot": {
                                            "type": "boolean"
                                        }
                                    }
                                },
                                "labels": {
                                    "description": "Static service-tree labels projected onto the controller Deployment and pod (reloader has no `global.commonLabels` passthrough, so the projection rides the chart's own deployment-label override). Keys stay consistent with `global.serviceTree`; overlays append the landscape label. The namespace-sourced platform label cannot be a static value, so the wrapper-owned LPSM ConfigMap carries the full dynamic LPSM projection.",
                                    "type": "object",
                                    "properties": {
                                        "atomi.cloud/layer": {
                                            "type": "string"
                                        },
                                        "atomi.cloud/module": {
                                            "type": "string"
                                        },
                                        "atomi.cloud/service": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "replicas": {
                                    "description": "Single controller replica; leadership election is off (enableHA: false), so one active instance is the generic default.",
                                    "type": "integer"
                                },
                                "resources": {
                                    "description": "CPU and memory envelopes for the controller container (VAP requires both requests and limits on every workload container).",
                                    "type": "object",
                                    "properties": {
                                        "limits": {
                                            "type": "object",
                                            "properties": {
                                                "cpu": {
                                                    "type": "string"
                                                },
                                                "memory": {
                                                    "type": "string"
                                                }
                                            }
                                        },
                                        "requests": {
                                            "type": "object",
                                            "properties": {
                                                "cpu": {
                                                    "type": "string"
                                                },
                                                "memory": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "reloadStrategy": {
                            "description": "Default reload strategy (rolling restart via a dated pod annotation); the env-vars/annotations strategies are not used.",
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}
