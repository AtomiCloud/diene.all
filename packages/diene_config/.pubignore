# Published archive keeps only lib/, example/, doc/, skills/, README.md,
# CHANGELOG.md, LICENSE, and pubspec.yaml. Everything below is dev/CI/test
# tooling that must not ship to pub.dev.
#
# Directory patterns are ROOT-ANCHORED with a leading slash. A bare `config/`
# would match at ANY depth and silently drop `lib/config/app_config.dart` — the
# migration entrypoint — from the archive, which the publish dry-run reveals
# only as an absence.
/.claude/
/.dart_tool/
/.direnv/
/.github/
/.kagent/
/.kloop/
/config/
/coverage/
/docs/
/nix/
/scripts/
/tasks/
/test/
/tool/
.coderabbit.yaml
.envrc
.markdownlint-cli2.jsonc
.markdownlint.json
.prettierrc.yaml
atomi_release.yaml
codecov.yml
flake.lock
flake.nix
Taskfile.yaml
CLAUDE.md
VERSION
