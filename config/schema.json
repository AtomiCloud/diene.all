{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/diene-flutter-base/config.schema.json",
  "title": "Diene Flutter Base Configuration",
  "type": "object",
  "required": ["app", "branding", "theme", "locale", "auth", "session", "api", "notifications", "onboarding"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "app": {
      "type": "object",
      "required": ["landscape", "platform", "service", "module", "version"],
      "properties": {
        "landscape": {
          "type": "string",
          "pattern": "^(lapras|pichu|pikachu|raichu)$"
        },
        "platform": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "service": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "module": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      },
      "additionalProperties": false
    },
    "branding": {
      "type": "object",
      "required": ["appName", "shortName", "logoAsset", "iconAsset"],
      "properties": {
        "appName": {
          "type": "string",
          "pattern": ".+"
        },
        "shortName": {
          "type": "string",
          "pattern": ".+"
        },
        "logoAsset": {
          "type": "string",
          "pattern": "^assets/"
        },
        "iconAsset": {
          "type": "string",
          "pattern": "^assets/"
        }
      },
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "required": ["mode", "primary", "secondary", "surfaceTint", "radius"],
      "properties": {
        "mode": {
          "enum": ["light", "dark", "system"]
        },
        "primary": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "secondary": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "surfaceTint": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "radius": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "locale": {
      "type": "object",
      "required": ["defaultLocale", "supportedLocales"],
      "properties": {
        "defaultLocale": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
        },
        "supportedLocales": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
          }
        }
      },
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "required": ["demoMode", "endpoint", "clientId", "resource", "redirectUri", "scopes"],
      "properties": {
        "demoMode": {
          "type": "boolean"
        },
        "endpoint": {
          "type": "string",
          "pattern": "^https?://"
        },
        "clientId": {
          "type": "string",
          "pattern": ".+"
        },
        "resource": {
          "type": "string",
          "pattern": "^https?://"
        },
        "redirectUri": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]+://callback$"
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": ".+"
          }
        }
      },
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "required": ["accessMinutes", "refreshDays"],
      "properties": {
        "accessMinutes": {
          "const": 10
        },
        "refreshDays": {
          "const": 14
        }
      },
      "additionalProperties": false
    },
    "api": {
      "type": "object",
      "required": ["baseUrl"],
      "properties": {
        "baseUrl": {
          "type": "string",
          "pattern": "^https?://"
        }
      },
      "additionalProperties": false
    },
    "notifications": {
      "type": "object",
      "required": ["enabled", "topic"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "topic": {
          "type": "string",
          "pattern": ".+"
        }
      },
      "additionalProperties": false
    },
    "onboarding": {
      "type": "object",
      "required": ["backendId"],
      "properties": {
        "backendId": {
          "type": "string",
          "pattern": ".+"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
