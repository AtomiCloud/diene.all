{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "server": {
      "type": "object",
      "properties": { "port": { "type": "integer", "minimum": 1, "maximum": 65535 } },
      "additionalProperties": false
    },
    "health": {
      "type": "object",
      "properties": { "path": { "type": "string", "pattern": "^/" } },
      "additionalProperties": false
    },
    "logging": {
      "type": "object",
      "properties": { "level": { "type": "string" } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
