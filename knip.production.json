{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.ts!",
    "src/app/**/{page,layout,error,global-error,not-found,loading}.tsx!",
    "src/app/**/route.ts!",
    "src/middleware.ts!",
    "src/i18n/request.ts!",
    "next.config.ts!"
  ],
  "project": ["src/**/*.{ts,tsx}!"],
  "bun": false,
  "github-actions": false,
  "node": false,
  "playwright": false,
  "taskfile": false,
  "typescript": false,
  "rules": {
    "files": "error",
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "duplicates": "off",
    "devDependencies": "off",
    "optionalPeerDependencies": "off",
    "binaries": "off",
    "enumMembers": "off"
  }
}
