watch_file "./nix/env.nix" "./nix/fmt.nix" "./nix/packages.nix" "./nix/shells.nix" "./nix/pre-commit.nix" "./flake.nix"
use flake

# scripts/local/skills-sync.sh needs go to enumerate dependency skills, but the
# generated pre-commit hook runs it under a restricted PATH without go. Capture
# the absolute go executable here (after the flake shell loads it) so every
# hook launched from this shell — pls lint, direct pre-commit run — honors it.
export DIENE_SKILLS_GO="$(command -v go 2>/dev/null || true)"
