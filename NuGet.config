<?xml version="1.0" encoding="utf-8"?>
<!--
  R-E12 dogfood evidence surface: this library consumes the PUBLISHED
  AtomiCloud.Diene.Result and AtomiCloud.Diene.Interfaces packages (plus their
  TestHelper companions in the test tiers). The <clear /> makes nuget.org the
  ONLY source, so no local folder feed, vendored nupkg, or path reference can
  silently satisfy the reference.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
