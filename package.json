{
  "name": "@atomicloud/diene.mercury",
  "version": "1.3.1",
  "private": true,
  "description": "Mercury multi-tenant webhook intake, delivery, replay, and management product",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "mercury": "src/index.ts"
  },
  "scripts": {
    "build": "./scripts/local/build.sh",
    "dev": "bun --hot src/index.ts serve",
    "start": "bun src/index.ts serve",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "bun test --config=bunfig.unit.toml",
    "test:integration": "bun test --config=bunfig.int.toml",
    "test:sit": "bun test --config=bunfig.sit.toml"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.1",
    "knip": "^6.23.0",
    "should": "^13.2.3",
    "testcontainers": "^12.0.4",
    "typescript": "^6.0.3"
  }
}
