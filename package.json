{
  "name": "bun-consumer",
  "version": "1.3.1",
  "private": true,
  "description": "Config-driven Bun Redis streams worker-consumer template",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "bun-consumer": "src/index.ts"
  },
  "scripts": {
    "build": "./scripts/local/build.sh",
    "test": "bun test --config=bunfig.unit.toml && bun test --config=bunfig.int.toml",
    "test:unit": "bun test --config=bunfig.unit.toml",
    "test:int": "bun test --config=bunfig.int.toml",
    "test:sit": "bun test --config=bunfig.sit.toml"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@atomicloud/diene.e2e": "1.1.0",
    "commander": "^15.0.0",
    "ioredis": "^5.11.1",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.1",
    "knip": "^6.23.0",
    "should": "^13.2.3",
    "testcontainers": "^12.0.4",
    "typescript": "^6.0.3"
  }
}
