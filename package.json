{
  "name": "@atomicloud/diene.core-utils",
  "version": "1.0.0",
  "description": "Result-based TypeScript core utilities and Temporal wire codecs for the AtomiCloud Bun family.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AtomiCloud/diene.bun-core-utils.git"
  },
  "homepage": "https://github.com/AtomiCloud/diene.bun-core-utils#readme",
  "bugs": {
    "url": "https://github.com/AtomiCloud/diene.bun-core-utils/issues"
  },
  "license": "MIT",
  "author": "AtomiCloud",
  "keywords": [
    "atomicloud",
    "bun",
    "core-utils",
    "temporal",
    "result",
    "filesystem",
    "concurrency",
    "esm",
    "cjs"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@atomicloud/diene.interfaces": "1.0.0",
    "@atomicloud/diene.result": "1.0.2",
    "@js-temporal/polyfill": "^0.5.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^2.5.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.1",
    "dts-bundle-generator": "^9",
    "knip": "^6.23.0",
    "publint": "^0.3.16",
    "should": "^13.2.3",
    "typescript": "^6.0.3"
  }
}
