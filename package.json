{
  "name": "@atomicloud/diene.standard-config",
  "version": "0.0.0",
  "description": "Infra config preset schemas (postgres, cache, kv, storage) + Testcontainers TestHelper for the AtomiCloud TypeScript family — keyed, UPPERCASE, secrets blank-in-yaml, composed into a lib/bun/config registry.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./test-helper": {
      "import": {
        "types": "./dist/test-helper.d.ts",
        "default": "./dist/test-helper.js"
      },
      "require": {
        "types": "./dist/test-helper.d.cts",
        "default": "./dist/test-helper.cjs"
      }
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AtomiCloud/diene.bun-standard-config.git"
  },
  "homepage": "https://github.com/AtomiCloud/diene.bun-standard-config#readme",
  "bugs": {
    "url": "https://github.com/AtomiCloud/diene.bun-standard-config/issues"
  },
  "license": "MIT",
  "author": "AtomiCloud",
  "keywords": [
    "atomicloud",
    "bun",
    "config",
    "presets",
    "postgres",
    "redis",
    "s3",
    "testcontainers",
    "zod",
    "esm",
    "cjs"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@atomicloud/diene.result": "^1.0.2"
  },
  "peerDependencies": {
    "@atomicloud/diene.config": "^1.0.0",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "testcontainers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@atomicloud/diene.config": "^1.0.0",
    "@biomejs/biome": "^2.5.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.1",
    "dts-bundle-generator": "^9",
    "knip": "^6.23.0",
    "publint": "^0.3.16",
    "should": "^13.2.3",
    "testcontainers": "^12.0.4",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
