{
  "name": "@atomicloud/diene.auth-engine",
  "version": "1.0.0",
  "description": "Edge-safe authentication engine, onboarding state machine, and deferred app handoff for the Diene Bun family.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./test-helper": {
      "import": {
        "types": "./dist/test-helper.d.ts",
        "default": "./dist/test-helper.js"
      },
      "require": {
        "types": "./dist/test-helper.d.cts",
        "default": "./dist/test-helper.cjs"
      }
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AtomiCloud/diene.bun-auth-engine.git"
  },
  "homepage": "https://github.com/AtomiCloud/diene.bun-auth-engine#readme",
  "bugs": {
    "url": "https://github.com/AtomiCloud/diene.bun-auth-engine/issues"
  },
  "license": "MIT",
  "author": "AtomiCloud",
  "keywords": [
    "atomicloud",
    "bun",
    "authentication",
    "authorization",
    "onboarding",
    "oidc",
    "jwt",
    "deferred-deep-link",
    "edge-runtime",
    "esm",
    "cjs"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@atomicloud/diene.core-utils": "1.0.0",
    "@atomicloud/diene.problems": "1.0.0",
    "@atomicloud/diene.result": "1.0.2",
    "@js-temporal/polyfill": "^0.5.1",
    "@logto/js": "^6.1.2",
    "ioredis": "^5.11.1",
    "jose": "^6.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^2.5.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.1",
    "dts-bundle-generator": "^9",
    "knip": "^6.23.0",
    "publint": "^0.3.16",
    "should": "^13.2.3",
    "testcontainers": "^12.0.4",
    "typescript": "^6.0.3"
  }
}
