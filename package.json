{
  "name": "@atomicloud/diene.mercury",
  "version": "1.3.1",
  "private": true,
  "description": "Mercury multi-tenant webhook intake, delivery, replay, and management product",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "mercury": "src/index.ts"
  },
  "scripts": {
    "build": "./scripts/local/build.sh",
    "dev": "bun --hot src/index.ts serve",
    "start": "bun src/index.ts serve",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "bun test --config=bunfig.unit.toml",
    "test:integration": "bun test --config=bunfig.int.toml",
    "test:sit": "bun test --config=bunfig.sit.toml"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@atomicloud/diene.config": "1.0.0",
    "@atomicloud/diene.otel": "1.0.0",
    "@atomicloud/diene.problems": "1.0.0",
    "@atomicloud/diene.result": "1.0.2",
    "@noble/ed25519": "3.1.0",
    "hono": "4.12.32",
    "ioredis": "^5.11.1",
    "jose": "6.2.4",
    "pino": "9.14.0",
    "postgres": "3.4.9",
    "prom-client": "15.1.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.1",
    "knip": "^6.23.0",
    "should": "^13.2.3",
    "testcontainers": "^12.0.4",
    "typescript": "^6.0.3"
  }
}
