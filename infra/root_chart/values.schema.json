{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "nonEmptySelector": {
      "type": "object",
      "minProperties": 1,
      "anyOf": [
        {
          "required": ["matchLabels"],
          "properties": { "matchLabels": { "type": "object", "minProperties": 1 } }
        },
        {
          "required": ["matchExpressions"],
          "properties": { "matchExpressions": { "type": "array", "minItems": 1 } }
        }
      ]
    }
  },
  "type": "object",
  "required": ["labelPrefix", "serviceTree", "image", "replicaCount", "dbInit", "service", "probes", "resources", "autoscaling", "pdb", "networkPolicy", "secret", "serviceMonitor"],
  "properties": {
    "labelPrefix": { "type": "string", "minLength": 1 },
    "serviceTree": {
      "type": "object",
      "required": ["platform", "service", "module", "layer"],
      "properties": {
        "platform": { "const": "mercury" },
        "service": { "const": "webhook" },
        "module": { "const": "hooks" },
        "layer": { "type": "string", "pattern": "^[0-9]+$" },
        "landscape": { "type": "string" },
        "cluster": { "type": "string" }
      }
    },
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "not": { "const": "latest" } },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "pullSecrets": { "type": "array", "items": { "type": "object" } }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "dbInit": {
      "type": "object",
      "required": ["enabled", "backoffLimit", "activeDeadlineSeconds", "ttlSecondsAfterFinished"],
      "properties": {
        "enabled": { "type": "boolean" },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 }
      }
    },
    "service": {
      "type": "object",
      "required": ["port", "metricsPort"],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "metricsPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" }
      }
    },
    "probes": {
      "type": "object",
      "required": ["livePath", "readyPath", "startupPath", "periodSeconds", "timeoutSeconds", "failureThreshold"],
      "properties": {
        "livePath": { "type": "string", "pattern": "^/" },
        "readyPath": { "type": "string", "pattern": "^/" },
        "startupPath": { "type": "string", "pattern": "^/" },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "resources": { "type": "object" },
    "autoscaling": {
      "type": "object",
      "required": ["enabled", "minReplicas", "maxReplicas", "targetCPUUtilizationPercentage"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "pdb": { "type": "object", "required": ["enabled", "maxUnavailable"] },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "ingressNamespaceSelector", "monitoringNamespaceSelector", "dns", "inClusterDelivery", "externalEgress"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressNamespaceSelector": { "$ref": "#/$defs/nonEmptySelector" },
        "monitoringNamespaceSelector": { "$ref": "#/$defs/nonEmptySelector" },
        "dns": {
          "type": "object",
          "required": ["namespaceSelector", "ports"],
          "properties": {
            "namespaceSelector": { "$ref": "#/$defs/nonEmptySelector" },
            "ports": { "type": "array", "minItems": 1, "items": { "type": "object" } }
          }
        },
        "inClusterDelivery": {
          "type": "object",
          "required": ["destinations"],
          "properties": {
            "destinations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["namespaceSelector", "podSelector", "ports"],
                "properties": {
                  "namespaceSelector": { "$ref": "#/$defs/nonEmptySelector" },
                  "podSelector": { "$ref": "#/$defs/nonEmptySelector" },
                  "ports": { "type": "array", "minItems": 1, "items": { "type": "object" } }
                }
              }
            }
          }
        },
        "externalEgress": {
          "type": "object",
          "required": ["enabled", "gateway", "direct"],
          "properties": {
            "enabled": { "type": "boolean" },
            "gateway": {
              "type": "object",
              "required": ["enabled"],
              "properties": {
                "enabled": { "type": "boolean" },
                "namespaceSelector": { "$ref": "#/$defs/nonEmptySelector" },
                "ports": { "type": "array", "minItems": 1, "items": { "type": "object" } }
              },
              "allOf": [
                {
                  "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
                  "then": { "required": ["namespaceSelector", "ports"] }
                }
              ]
            },
            "direct": {
              "type": "object",
              "required": ["enabled"],
              "properties": {
                "enabled": { "type": "boolean" },
                "cidrs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["cidr"],
                    "properties": {
                      "cidr": { "type": "string", "minLength": 1 },
                      "except": { "type": "array", "items": { "type": "string" } }
                    }
                  }
                },
                "ports": { "type": "array", "minItems": 1, "items": { "type": "object" } }
              },
              "allOf": [
                {
                  "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
                  "then": { "required": ["cidrs", "ports"] }
                }
              ]
            }
          }
        }
      }
    },
    "secret": {
      "type": "object",
      "required": ["enabled", "refreshInterval", "store", "sharedFolder", "serviceFolder", "providerFolder", "endpointFolder"],
      "properties": {
        "enabled": { "type": "boolean" },
        "refreshInterval": { "type": "string" },
        "store": {
          "type": "object",
          "required": ["kind", "name"],
          "properties": {
            "kind": { "enum": ["SecretStore", "ClusterSecretStore"] },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        "sharedFolder": { "type": "string", "pattern": "^/" },
        "serviceFolder": { "type": "string", "pattern": "^/" },
        "providerFolder": { "type": "string", "pattern": "^/" },
        "endpointFolder": { "type": "string", "pattern": "^/" }
      }
    },
    "env": { "type": "array", "items": { "type": "object" } },
    "serviceMonitor": { "type": "object", "required": ["enabled", "interval"] },
    "alerts": { "type": "object", "required": ["enabled"] },
    "dashboard": { "type": "object", "required": ["enabled"] },
    "podSecurityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 }
  }
}
