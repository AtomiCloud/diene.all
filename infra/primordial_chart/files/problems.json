{
  "apiVersion": "atomi.cloud/v1alpha1",
  "kind": "Problem",
  "metadata": {
    "name": "go-consumer-lapras-v1",
    "namespace": "diene"
  },
  "spec": {
    "platform": "diene",
    "service": "go-consumer",
    "landscape": "lapras",
    "version": "v1",
    "problems": [
      {
        "data": {
          "additionalProperties": false,
          "properties": {
            "messageId": {
              "minLength": 1,
              "type": "string"
            },
            "stage": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "messageId",
            "stage"
          ],
          "type": "object"
        },
        "endpoints": [
          {
            "method": "CONSUME",
            "path": "/streams/go-consumer.messages"
          }
        ],
        "id": "message_handler_failed",
        "recoverable": true,
        "status": 500,
        "title": "Message handler failed",
        "type": "https://errors.atomi.cloud/docs/lapras/diene/go-consumer/worker/v1/message_handler_failed"
      }
    ]
  }
}
