        "blockMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "consumerGroup": {
          "type": "string",
          "minLength": 1
        },
        "consumerName": {
          "type": "string",
          "minLength": 1
        },
        "idleMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stream": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "batchSize",
        "blockMs",
        "consumerGroup",
        "consumerName",
        "idleMs",
        "stream"
      ],
      "additionalProperties": false
    },
    "errorPortal": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "landscape": {
          "type": "string",
          "minLength": 1
        },
        "module": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "scheme": {
          "type": "string",
          "enum": [
            "http",
            "https"
          ]
        },
        "service": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^v\\d+$"
        }
      },
      "required": [
        "host",
        "landscape",
        "module",
        "platform",
        "scheme",
        "service",
        "version"
      ],
      "additionalProperties": false
    },
    "domain": {
      "type": "object",
      "properties": {
        "blobPrefix": {
          "type": "string",
          "minLength": 1
