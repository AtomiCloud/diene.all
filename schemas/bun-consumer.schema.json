    "api": {
      "type": "object",
      "properties": {
        "backends": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "coordinate": {
                "type": "object",
                "properties": {
                  "landscape": {
                    "type": "string",
                    "minLength": 1
                  },
                  "platform": {
                    "type": "string",
                    "minLength": 1
                  },
                  "service": {
                    "type": "string",
                    "minLength": 1
                  },
                  "module": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "landscape",
                  "platform",
                  "service",
                  "module"
                ],
                "additionalProperties": false
              },
              "resource": {
                "type": "object",
                "properties": {
                  "platform": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 63,
                    "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
                  },
                  "landscape": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 63,
                    "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
                  },
                  "service": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 63,
                    "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
                  },
                  "resourceName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 63,
                    "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
                  }
                },
                "required": [
                  "platform",
                  "landscape",
                  "service",
                  "resourceName"
                ],
                "additionalProperties": false
              },
              "retry": {
                "default": "opaque-network-once",
                "type": "string",
                "const": "opaque-network-once"
              },
              "timeoutMs": {
                "default": 15000,
                "type": "number",
                "exclusiveMinimum": 0
              },
              "baseUrl": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "coordinate",
              "resource",
              "retry",
              "timeoutMs",
              "baseUrl"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "backends"
      ],
      "additionalProperties": false
