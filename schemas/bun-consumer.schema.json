    "auth": {
      "type": "object",
      "properties": {
        "logto": {
          "type": "object",
          "properties": {
            "endpoint": {
              "type": "string",
              "format": "uri"
            },
            "appId": {
              "type": "string",
              "minLength": 1
            },
            "appSecret": {
              "type": "string"
            },
            "management": {
              "type": "object",
              "properties": {
                "endpoint": {
                  "type": "string",
                  "format": "uri"
                },
                "clientId": {
                  "type": "string",
                  "minLength": 1
                },
                "clientSecret": {
                  "type": "string"
                }
              },
              "required": [
                "endpoint",
                "clientId",
                "clientSecret"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "endpoint",
            "appId",
            "appSecret",
            "management"
          ],
          "additionalProperties": false
        },
        "handoff": {
          "type": "object",
          "properties": {
            "mount": {
              "default": "/app-handoff",
              "type": "string",
              "pattern": "^\\/(?!\\/)(?!.*\\/\\/)(?!.*[\\\\%?#\\s]).*$"
            }
          },
          "required": [
            "mount"
          ],
          "additionalProperties": false
        },
        "store": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "redis"
            },
            "host": {
              "type": "string",
              "minLength": 1
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "required": [
            "kind",
            "host",
            "port"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "logto",
        "handoff",
        "store"
      ],
      "additionalProperties": false
