        "maxMessageBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "blobPrefix",
        "maxMessageBytes"
      ],
      "additionalProperties": false
    },
    "dbInit": {
      "type": "object",
      "properties": {
        "createBucket": {
          "type": "boolean"
        },
        "migrationsDir": {
          "type": "string",
          "minLength": 1
        },
        "redisMigrationKey": {
          "type": "string",
          "minLength": 1
        },
        "seedDir": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "createBucket",
        "migrationsDir",
        "redisMigrationKey",
        "seedDir"
      ],
      "additionalProperties": false
    },
    "health": {
      "type": "object",
      "properties": {
        "heartbeatFile": {
          "type": "string",
          "minLength": 1
        },
        "maxAgeMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "heartbeatFile",
        "maxAgeMs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "postgres",
    "cache",
    "kv",
    "storage",
    "app",
    "otel",
    "auth",
    "api",
    "encryption",
    "transport",
    "errorPortal",
    "domain",
    "dbInit",
    "health"
  ],
  "additionalProperties": false
}
