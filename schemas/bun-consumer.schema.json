                  "additionalProperties": false
                }
              },
              "required": [
                "console",
                "otlp"
              ],
              "additionalProperties": false
            },
            "interval": {
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "exporter",
            "interval"
          ],
          "additionalProperties": false
        },
        "traces": {
          "readOnly": true,
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "sampler": {
              "readOnly": true,
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "parentbased_traceidratio",
                    "always_on",
                    "always_off"
                  ]
                },
                "ratio": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "type",
                "ratio"
              ],
              "additionalProperties": false
            },
            "exporter": {
              "readOnly": true,
              "type": "object",
              "properties": {
                "console": {
                  "readOnly": true,
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "enabled"
                  ],
                  "additionalProperties": false
                },
                "otlp": {
                  "readOnly": true,
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "endpoint": {
                      "type": "string"
                    },
                    "protocol": {
                      "type": "string",
                      "const": "http/protobuf"
                    },
                    "headers": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "timeout": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "enabled",
                    "endpoint",
                    "protocol",
                    "headers",
                    "timeout"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "console",
                "otlp"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "enabled",
            "sampler",
            "exporter"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "logs",
        "metrics",
        "traces"
      ],
      "additionalProperties": false
