{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "external-secrets.io/v1" },
    "kind": { "const": "ExternalSecret" },
    "metadata": {
      "type": "object",
      "required": ["name", "namespace"],
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "required": ["refreshInterval", "secretStoreRef", "target", "dataFrom"],
      "properties": {
        "refreshInterval": { "type": "string" },
        "secretStoreRef": {
          "type": "object",
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "ClusterSecretStore" },
            "name": { "const": "cobalt-sos" }
          },
          "additionalProperties": false
        },
        "target": {
          "type": "object",
          "required": ["name", "creationPolicy"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "creationPolicy": { "const": "Owner" }
          },
          "additionalProperties": false
        },
        "dataFrom": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["extract"],
            "properties": {
              "extract": {
                "type": "object",
                "required": ["key"],
                "properties": {
                  "key": { "type": "string", "pattern": "^/" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
