{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diene.invalid/schemas/externalsecret.json",
  "title": "ExternalSecret (external-secrets.io/v1, folder-prefix mapping)",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "external-secrets.io/v1" },
    "kind": { "const": "ExternalSecret" },
    "metadata": {
      "type": "object",
      "required": ["name", "namespace", "labels", "annotations"],
      "properties": {
        "name": { "const": "zinc-cloudflare" },
        "namespace": { "type": "string", "minLength": 1 },
        "labels": { "type": "object" },
        "annotations": { "type": "object" }
      },
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "required": ["refreshInterval", "secretStoreRef", "target", "dataFrom"],
      "properties": {
        "refreshInterval": { "type": "string", "minLength": 1 },
        "secretStoreRef": {
          "type": "object",
          "required": ["kind", "name"],
          "properties": {
            "kind": { "enum": ["ClusterSecretStore", "SecretStore"] },
            "name": { "type": "string", "pattern": "^zinc-[a-z0-9]+$" }
          },
          "additionalProperties": false
        },
        "target": {
          "type": "object",
          "required": ["name", "creationPolicy"],
          "properties": {
            "name": { "const": "zinc-cloudflare" },
            "creationPolicy": { "const": "Owner" }
          },
          "additionalProperties": false
        },
        "dataFrom": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": ["find", "rewrite"],
            "properties": {
              "find": {
                "type": "object",
                "required": ["path"],
                "properties": {
                  "path": { "type": "string", "pattern": "^/shared/" }
                },
                "additionalProperties": false
              },
              "rewrite": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "object",
                  "required": ["regexp"],
                  "properties": {
                    "regexp": {
                      "type": "object",
                      "required": ["source", "target"],
                      "properties": {
                        "source": { "const": "(.*)" },
                        "target": { "const": "SHARED_$1" }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
