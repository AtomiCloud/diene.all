{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "gateway.networking.k8s.io/v1" },
    "kind": { "const": "GatewayClass" },
    "metadata": { "type": "object", "required": ["name"] },
    "spec": {
      "type": "object",
      "required": ["controllerName"],
      "properties": {
        "controllerName": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)+/[a-z0-9-]+$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
