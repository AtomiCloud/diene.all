{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diene.invalid/schemas/clustersecretstore.json",
  "title": "ClusterSecretStore (external-secrets.io/v1, Infisical provider)",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": ["external-secrets.io/v1"]
    },
    "kind": {
      "type": "string",
      "enum": ["ClusterSecretStore"]
    },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+-[a-z0-9]+$"
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["provider"],
      "properties": {
        "provider": {
          "type": "object",
          "required": ["infisical"],
          "properties": {
            "infisical": {
              "type": "object",
              "required": ["hostAPI", "auth", "secretsScope"],
              "properties": {
                "hostAPI": {
                  "type": "string",
                  "pattern": "^https?://.*"
                },
                "auth": {
                  "type": "object",
                  "required": ["universalAuthCredentials"],
                  "properties": {
                    "universalAuthCredentials": {
                      "type": "object",
                      "required": ["clientId", "clientSecret"],
                      "properties": {
                        "clientId": {
                          "type": "object",
                          "required": ["name", "key", "namespace"]
                        },
                        "clientSecret": {
                          "type": "object",
                          "required": ["name", "key", "namespace"]
                        }
                      }
                    }
                  }
                },
                "secretsScope": {
                  "type": "object",
                  "required": ["projectSlug", "environmentSlug", "secretsPath", "recursive"],
                  "properties": {
                    "projectSlug": {
                      "type": "string",
                      "pattern": "^[a-z0-9-]+$"
                    },
                    "environmentSlug": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[a-z0-9-]+$"
                    },
                    "secretsPath": {
                      "type": "string",
                      "pattern": "^/.*$"
                    },
                    "recursive": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
