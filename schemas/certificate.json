{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "cert-manager.io/v1" },
    "kind": { "const": "Certificate" },
    "metadata": { "type": "object", "required": ["name"] },
    "spec": {
      "type": "object",
      "required": ["secretName", "issuerRef"],
      "properties": {
        "secretName": { "type": "string", "minLength": 1 },
        "issuerRef": {
          "type": "object",
          "required": ["name", "kind"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "kind": { "type": "string", "minLength": 1 },
            "group": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "dnsNames": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "commonName": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
