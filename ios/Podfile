platform :ios, '13.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug-lapras' => :debug,
  'Profile-lapras' => :release,
  'Release-lapras' => :release,
  'Debug-pichu' => :debug,
  'Profile-pichu' => :release,
  'Release-pichu' => :release,
  'Debug-pikachu' => :debug,
  'Profile-pikachu' => :release,
  'Release-pikachu' => :release,
  'Debug-raichu' => :debug,
  'Profile-raichu' => :release,
  'Release-raichu' => :release,
}

def flutter_root
  settings = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(settings)
    raise "#{settings} is missing; run flutter pub get before pod install"
  end

  File.foreach(settings) do |line|
    match = line.match(/FLUTTER_ROOT=(.*)/)
    return match[1].strip if match
  end
  raise "FLUTTER_ROOT is missing from #{settings}"
end
require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end
