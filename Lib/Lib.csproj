<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AtomiCloud.Diene.Interfaces</RootNamespace>
    <AssemblyName>AtomiCloud.Diene.Interfaces</AssemblyName>
    <PackageId>AtomiCloud.Diene.Interfaces</PackageId>
    <Description>Implementation-free system, virtual filesystem, terminal, logging, and metrics seams that return Result instead of throwing.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AtomiCloud.Diene.Result" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../logo.png" Pack="true" PackagePath="/" />
    <None Include="../skills/**" Pack="true" PackagePath="skills/" />
  </ItemGroup>

</Project>
