<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AtomiCloud.Diene.Problems</RootNamespace>
    <AssemblyName>AtomiCloud.Diene.Problems</AssemblyName>
    <PackageId>AtomiCloud.Diene.Problems</PackageId>
    <Description>Typed RFC 9457 problems, catalogs, exports, and ASP.NET Core integration for Diene services.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AtomiCloud.Diene.CoreUtils" />
    <PackageReference Include="AtomiCloud.Diene.Result" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../logo.png" Pack="true" PackagePath="/" />
    <None Include="../skills/**" Pack="true" PackagePath="skills/" />
  </ItemGroup>

</Project>
