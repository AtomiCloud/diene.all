<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AtomiCloud.Diene.Results</RootNamespace>
    <AssemblyName>AtomiCloud.Diene.Result</AssemblyName>
    <PackageId>AtomiCloud.Diene.Result</PackageId>
    <Description>Allocation-free typed Result and Option monads with explicit C0 wire codecs.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../logo.png" Pack="true" PackagePath="/" />
    <None Include="../skills/**" Pack="true" PackagePath="skills/" />
  </ItemGroup>

</Project>
