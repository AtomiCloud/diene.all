<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AtomiCloud.Diene.ServerEngine</RootNamespace>
    <AssemblyName>AtomiCloud.Diene.ServerEngine</AssemblyName>
    <PackageId>AtomiCloud.Diene.ServerEngine</PackageId>
    <Description>MVC server wiring for Diene services: the AtomiController base, the exception-to-Problem filter, the system controller, OnboardSync endpoints, and the signed /internal/webhooks/{provider} receiver.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AtomiCloud.Diene.AuthEngine" />
    <PackageReference Include="AtomiCloud.Diene.CoreUtils" />
    <PackageReference Include="AtomiCloud.Diene.Problems" />
    <PackageReference Include="AtomiCloud.Diene.Result" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../logo.png" Pack="true" PackagePath="/" />
    <None Include="../skills/**" Pack="true" PackagePath="skills/" />
  </ItemGroup>

</Project>
