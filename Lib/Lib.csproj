<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AtomiCloud.Diene.AuthEngine</RootNamespace>
    <AssemblyName>AtomiCloud.Diene.AuthEngine</AssemblyName>
    <PackageId>AtomiCloud.Diene.AuthEngine</PackageId>
    <Description>Logto-compatible token validation, scope policy checks, and client-credentials acquisition for Diene services.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The endpoint handlers stay internal so they are not part of the published API
         surface, but the unit suite drives them directly rather than through a host. -->
    <InternalsVisibleTo Include="UnitTest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AtomiCloud.Diene.CoreUtils" />
    <PackageReference Include="AtomiCloud.Diene.Problems" />
    <PackageReference Include="AtomiCloud.Diene.Result" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../logo.png" Pack="true" PackagePath="/" />
    <None Include="../skills/**" Pack="true" PackagePath="skills/" />
  </ItemGroup>

</Project>
