{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atomi.cloud/diene/probes/features.schema.json",
  "title": "Diene classed probe feature set",
  "type": "array",
  "minItems": 1,
  "uniqueItems": true,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["template", "name", "class"],
    "properties": {
      "template": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "class": {
        "enum": ["gate", "smoke", "presence"]
      },
      "deferredUntil": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
