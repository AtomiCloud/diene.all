<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AtomiCloud.Diene.ApiEngine.TestHelper</RootNamespace>
    <AssemblyName>AtomiCloud.Diene.ApiEngine.TestHelper</AssemblyName>
    <PackageId>AtomiCloud.Diene.ApiEngine.TestHelper</PackageId>
    <Description>Fake upstreams, client-tree doubles, response fixtures, and Result-Problem assertions for AtomiCloud.Diene.ApiEngine.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Lib/Lib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- auth-engine's published credential fake is consumed rather than reimplemented, so this
         package's token helper imitates no contract of its own. -->
    <PackageReference Include="AtomiCloud.Diene.AuthEngine.TestHelper" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../logo.png" Pack="true" PackagePath="/" />
    <None Include="../skills/**" Pack="true" PackagePath="skills/" />
  </ItemGroup>

</Project>
